# X-VAULT environment — copy to .env for local dev, set as Vercel project env vars in production.

# ── Database ─────────────────────────────────────────────────────────────────
# Postgres connection string (Supabase / Neon / Railway).
# If unset, dev falls back to local SQLite at data/marketplace.db.
DATABASE_URL=

# ── Secrets (all required in production) ─────────────────────────────────────
# AES-256-GCM key for stock item encryption. Must be ≥ 32 chars of random bytes.
# Generate: openssl rand -hex 32
STOCK_ENCRYPTION_KEY=

# Session signing secret. Required in production — app refuses to start without it.
# Generate: openssl rand -hex 32
SESSION_SECRET=

# Legacy cookie / at-rest secrets (kept for backward compatibility; keep stable).
COOKIE_SECRET=
ENCRYPTION_KEY=

# ── Web Push (optional — PWA notifications) ───────────────────────────────────
# Generate VAPID key pair: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@yoursite.com

# ── Site metadata ─────────────────────────────────────────────────────────────
# Canonical origin used for SEO, OG tags, sitemap, robots.txt, JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
