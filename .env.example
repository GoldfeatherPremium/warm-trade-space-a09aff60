# X-VAULT environment (local .env and Vercel project settings)
# Postgres connection string (Supabase). If unset, dev falls back to local SQLite.
DATABASE_URL=
# Encryption key for stock item contents (required in prod).
STOCK_ENCRYPTION_KEY=
# Session signing / cookie / at-rest secrets (wired during the migration; keep stable).
SESSION_SECRET=
COOKIE_SECRET=
ENCRYPTION_KEY=
# Canonical site origin for SEO/metadata/canonicals/OG/sitemap/robots/JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Object storage / CDN for product images (H6). When set, new image uploads go
# to Vercel Blob (served from the edge CDN) instead of base64 in Postgres.
# Auto-injected by Vercel when a Blob store is linked; unset = inline base64.
# After setting it, run: npx tsx scripts/backfill-images.ts  to migrate old images.
BLOB_READ_WRITE_TOKEN=
